# Generated by BasicGameEngine export executable
game define space-rocks title ASTEROIDS version 1
plugin import-set asteroids include bge.2d.arcade|bge.piece.vector-ship|bge.piece.breakable-rock-field|bge.piece.projectile|bge.piece.ufo|bge.piece.scoreboard|bge.piece.title-screen|bge.piece.audio
viewport fit-host --design-size 1024x768 --wrap-x --wrap-y --background black
counter define score 0 min 0
counter define high-score 0 min 0 persist session
counter define lives 3 min 0 max 5
counter define wave 1 min 1
projectile create --id shot --owner player --shape line --speed 620 --ttl 1.1 --wrap
projectile create --id enemy-shot --owner enemy --shape line --speed 420 --ttl 1.4 --wrap
sound define --id shot --kind tone --freq 880 --duration 0.08 --volume 0.6
player-ship create --id player_ship --shape vector-ship --lives lives --input-profile arrows-space --fire shot --hyperspace H --respawn 1.5 --invulnerable 2.0 --style outline
rock-field create --sizes large|medium|small --count 4 --split 2 --score score:20|50|100 --speed-range 30..180 --wave-counter wave --avoid player_ship:160 --style outline
scoreboard create --counters score|high-score|lives|wave --anchor top-left --format SCORE:{score}|HIGH:{high-score}|LIVES:{lives}|WAVE:{wave} --font vector-5x7 --scale 2
title-screen create --text ASTEROIDS --subtitle PRESS_ENTER --start Enter --next playing --legend 20_LARGE_ROCK|50_MEDIUM_ROCK|100_SMALL_ROCK|200_SAUCER --credit 1_CREDIT_1_PLAY --blink
screen create --id game-over --when-state game-over --text GAME_OVER --score score --start Enter --next playing
